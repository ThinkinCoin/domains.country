{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:security && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "npm run check:security && npm run test:api && npm run test:sites",
    "check:security": "node scripts/check-security.mjs",
    "test:api": "node --test api/_lib/*.test.js api/_lib/phase-zero/*.test.js src/lib/*.test.js",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "phase0:validate": "node scripts/validate-phase-zero.mjs",
    "phase0:manifest-digest": "node scripts/print-phase-zero-manifest-digest.mjs",
    "phase0:record-digests": "node scripts/print-phase-zero-record-digests.mjs",
    "phase0:collect-provenance": "node scripts/collect-phase-zero-provenance.mjs",
    "phase0:collect-parent-dns": "node scripts/collect-phase-zero-parent-dns.mjs",
    "phase0:collect-creation-traces": "node scripts/collect-phase-zero-creation-traces.mjs",
    "phase0:verify-creation-traces": "node scripts/verify-phase-zero-creation-traces.mjs",
    "phase0:generate-contract-trace-review": "node scripts/generate-phase-zero-contract-trace-review.mjs",
    "phase0:generate-contract-baseline-draft": "node scripts/generate-phase-zero-contract-baseline-draft.mjs",
    "phase0:collect-dc-config": "node scripts/collect-phase-zero-dc-configuration.mjs",
    "phase0:compare-candidate": "node scripts/compare-phase-zero-candidate.mjs",
    "phase0:collect-metadata-cids": "node scripts/collect-bytecode-metadata-cids.mjs",
    "phase0:verify-local-bytecodes": "node scripts/verify-local-bytecode-copies.mjs",
    "phase0:verify-safe-controller-local": "node scripts/verify-phase-zero-safe-controller-local.mjs",
    "phase0:verify-vercel-preview": "node scripts/verify-phase-zero-vercel-preview.mjs",
    "phase0:generate-evidence-index": "node scripts/generate-phase-zero-evidence-index.mjs",
    "phase0:verify-evidence-index": "node scripts/verify-phase-zero-evidence-index.mjs",
    "phase0:verify-powerdns-rollback": "node scripts/verify-powerdns-rollback-evidence.mjs",
    "phase0:verify-contract-baselines": "node scripts/verify-contract-baseline-evidence.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-wagmi": "1.8.23",
    "@tanstack/react-query": "^5.102.3",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "^2.55.19",
    "vite": "6.4.2",
    "wagmi": "^2.19.5"
  }
}
