{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "npm run test:api && npm run test:sites",
    "test:api": "node --test api/_lib/*.test.js api/_lib/phase-zero/*.test.js src/lib/*.test.js",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "phase0:validate": "node scripts/validate-phase-zero.mjs",
    "phase0:collect-provenance": "node scripts/collect-phase-zero-provenance.mjs",
    "phase0:compare-candidate": "node scripts/compare-phase-zero-candidate.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-wagmi": "1.8.23",
    "@tanstack/react-query": "^5.102.3",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "^2.55.19",
    "vite": "6.4.2",
    "wagmi": "^2.19.5"
  }
}
