# Railway API: never expose these values through the Vite build.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/railway
HARMONY_RPC_URL=https://api.harmony.one

# Production gate. The manifest remains versioned in app/api/_lib/phase-zero/.
PHASE_ZERO_EVIDENCE_MAX_AGE_SECONDS=900
PHASE_ZERO_DEV_BYPASS=false
SOURCE_REVISION=

# Exact browser origins only. Add each approved Vercel preview URL explicitly.
CORS_ALLOWED_ORIGINS=https://domains.country,https://dev.domains.country

# Operator authentication. Configure one or more checksummed EVM addresses.
ADMIN_NONCE_SECRET=replace-with-at-least-32-random-characters
ADMIN_OPERATOR_ADDRESSES=

# Internal Railway worker endpoint. Use a different random secret from ADMIN_NONCE_SECRET.
WORKER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Workers are fail-closed until Phase 0, PostgreSQL, delegation, and rollback evidence are ready.
INDEXER_ENABLED=false
POWERDNS_PUBLISHER_ENABLED=false
MIN_CONFIRMATIONS=12

# Required only when POWERDNS_PUBLISHER_ENABLED=true.
POWERDNS_API_URL=
POWERDNS_API_KEY=
POWERDNS_SERVER_ID=localhost
POWERDNS_NAMESERVERS=ns1.domains.country.,ns2.domains.country.,ns3.domains.country.

# Deployed contracts on Harmony Mainnet. Keep these server-only too.
REGISTRAR_CONTROLLER_ADDRESS=0x76c6fE3aEe636f88d01De64931514e8CD64D94Fb
DC_ADDRESS=0x547942748Cc8840FEc23daFdD01E6457379B446D
EWS_ADDRESS=0xf90dab949d3853c418bE361930028644B4EBcDE4
BASE_REGISTRAR_ADDRESS=0x4D64B78eAf6129FaC30aB51E6D2D679993Ea9dDD
TLD_NAME_WRAPPER_ADDRESS=0x4Cd2563118e57B19179d8DC033f2B0C5B5D69ff5
PUBLIC_RESOLVER_ADDRESS=0x46E37034Ffc87a969d1a581748Acf6a94Bc7415D
